# =====================================================================
# J.A.R.V.I.S. CONFIGURATION TEMPLATE
# Copy this file to .env and insert your personal API keys
# =====================================================================

# 1. Google Gemini AI API Key (Mandatory)
# Generate a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for sub-second function dispatching:
# gemini-3.5-flash-lite (fastest), gemini-3.6-flash, or gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Android Phone PIN (Optional)
# If your physical Android device uses a screen lock PIN, enter it here.
# When provided, J.A.R.V.I.S. enters it automatically so you never speak it aloud.
PHONE_PIN=1234

# 3. Gmail Integration (Optional)
# Required only if you intend to send emails via SMTP rather than browser
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# 4. Browser Session Directories
SESSION_DIR=.whatsapp_session
INSTAGRAM_SESSION_DIR=.instagram_session
